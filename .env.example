# the database you want to query (user's target DB)
DATABASE_URL=postgresql://user:password@localhost:5432/targetdb?sslmode=require&channel_binding=require

# QueryMate's own Postgres — stores users, sessions, and conversation history
# this must be a separate database from DATABASE_URL (the DB to be queried)
MEMORY_DATABASE_URL=postgresql://user:password@localhost:5432/memorydb?sslmode=require&channel_binding=require

# Redis — session cache (stores active connection metadata)
REDIS_URL=redis://localhost:6379


# models API keys - only fill in the ones you are using. you can also experiment different models performance here.
ANTHROPIC_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...


# logging
LOG_LEVEL=INFO